# Copy to deploy/replicas.env (git-ignored) and fill in.
ADMIN_TOKEN=change-me-to-a-long-random-value
POSTGRES_PASSWORD=change-me
# Your domain for automatic HTTPS, or :80 on a private network.
OSISS_SITE=:80
PUBLIC_BASE_URL=
# Admin app address(es) allowed to reach /api/admin/*; 0.0.0.0/0 = anyone (token still required).
ADMIN_IP=0.0.0.0/0
# Optional: REDIS_URL=redis://redis:6379/0 together with "--profile redis".
REDIS_URL=
# Optional: STORAGE_BACKEND=s3 with S3_BUCKET / S3_REGION (credentials from the environment or instance role).
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
MODELS_S3_URI=
MODEL_PRECISION=fp32
SEARCH_CONCURRENCY=2
